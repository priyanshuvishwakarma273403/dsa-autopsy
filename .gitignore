.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version if you use pyenv
#   but usually it's local.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of microservices or CLI tools, lock file is essential. For libraries, not.
#   For uv, uv.lock should be committed if this is an application/CLI tool, but we can keep it open.
#   Let's not ignore uv.lock.

# poetry
#   Similar to pipenv, poetry.lock is committed.

# pdm
#   Similar to pipenv, pdm.lock is committed.

# PEP 582; dependency directories created by pipflow or pdm if used
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
venv/
ENV/
env/
active/
conda-env/

